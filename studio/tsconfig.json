{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "scripts/*.ts", "vite.config.ts", "vitest.config.ts"],
  // they depend on unversioned local folders (References/, Snowdon Towers Example/) and on code without strict types
  "exclude": ["test/ifcx-compose.test.ts", "test/structure-unit-price.test.ts", "scripts/compare-ifcx.ts"]
}
